cat > .gitignore <<'EOF'
# Dependencies
**/node_modules/

# Environment variables
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test

# Keep examples
!**/.env.example

# Build outputs
**/.next/
**/dist/
**/out/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
EOF
# Environment files
**/.env
**/.env.*
!**/.env.example
